datasets/*
!datasets/MANIFEST.json
target/
reports/*/

# PyPI upload token, dropped locally; never tracked
.pypi

# Development-build bundles (harness patched to a local Grust checkout); never published
reports-dev/

# Dev-build target dir (harness built with extra features for adapter work)
target-dev/

# Bundles pulled from the other hosts for site admission; published from the site repo, not here
reports-hosts/
__pycache__/

# The 2xlarge-4c-32g host class (eigen, grust): bundles eigen returns, rendered as their own cells (AG_HOST_PROFILE)
reports-2xlarge/

# Lane logs (ag-h2h.sh appends to logs-<lane>.log in the repo root) and
# voided/backup scratch from benchmark campaigns; never published
logs-*.log
reports-void-*/
*.backup
Cargo.toml.*-backup
